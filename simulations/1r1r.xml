    <Ramp id="one_out">
        <connectedPart type="in">
            <roadID value="road_one"/>
            <i value="2"/>
            <j value="0"/>
            <t value="0.9"/>
        </connectedPart>
        <controlPoints type="Bezier" n="101">
            <point coord="(900,480,100)"/>
            <point coord="(1000,200,100)"/>
        </controlPoints>
    </Ramp>

